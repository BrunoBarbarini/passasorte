{
  "name": "passasorte",
  "version": "0.0.0",
  "private": true,
  "description": "PassaSorte monorepo - platform, API, workers, mobile and web apps.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "load-test": "node scripts/load-test/campaigns-read.js",
    "pilot-simulation": "tsx scripts/pilot-simulation/run.ts",
    "backup:validate": "bash scripts/ops/validate-backup-restore.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0",
    "prisma": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "autocannon": "^7.15.0",
    "tsx": "^4.19.2"
  }
}
