# Copy to .env and adjust as needed for local development.
# See packages/config/src/env.schema.ts for the authoritative, validated list.

NODE_ENV=local
SERVICE_NAME=passasorte-api

PORT=3000
HOST=0.0.0.0

# Matches infrastructure/docker/docker-compose.yml
DATABASE_URL=postgresql://passasorte:passasorte@localhost:5432/passasorte
REDIS_URL=redis://localhost:6379

# Supabase (ADR-008) - Auth JWKS is derived from this URL.
SUPABASE_URL=https://jamnnombqebrsfradqrv.supabase.co

LOG_LEVEL=debug

# Leave unset locally to disable OTLP export while keeping instrumentation active.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_TRACES_SAMPLER_RATIO=1

# Legally-gated / sensitive feature flags - CLAUDE.md #1.9 and #22.
# Keep disabled until the corresponding compliance/product gate is approved.
ENABLE_NEW_PARTICIPATIONS=false
ENABLE_PAID_PARTICIPATION=false
ENABLE_MOVEMENTS=false
ENABLE_GAME_AUTO_ADVANCE=false
ENABLE_BENEFIT_REDEMPTION=false
ENABLE_PAYMENT_CAPTURE=false

# Phase 9 (Pilot Launch) - controlled merchants, capped active rooms.
# `false` by default: unset, the whole gate is a no-op and every merchant/
# room behaves exactly as before. See packages/domain/src/pilot/pilot-policy.ts
# and docs/runbooks/pilot-launch.md for the operational rationale.
PILOT_MODE_ENABLED=false
# Comma-separated merchant UUIDs allowed while the pilot is enabled.
# Left empty with PILOT_MODE_ENABLED=true means NO merchant is allowed yet
# (safe failure mode - never "allow all").
# PILOT_ALLOWED_MERCHANT_IDS=
# Maximum number of simultaneously active rooms platform-wide while the
# pilot is enabled. Left unset means no cap - do not invent a number here;
# the pilot operator decides this value (see the runbook).
# PILOT_MAX_ACTIVE_ROOMS=
