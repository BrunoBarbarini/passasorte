# Copy to .env.local and fill in for local Expo development.
# The Supabase publishable/anon key is safe to ship in a client app.
EXPO_PUBLIC_SUPABASE_URL=https://jamnnombqebrsfradqrv.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_JBkU2dlK4cPgOWh7Wygg1g_Go7UQjw6

# Where apps/api is reachable from your device/simulator during local dev.
# Must include the /api/v1 prefix (apps/api/src/main.ts sets a global
# prefix "api/v1" on every route except /health) - a bare host:port here
# causes every call in src/lib/api-client.ts (e.g. apiRequest("/campaigns"))
# to 404, since those paths don't repeat the prefix themselves.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
