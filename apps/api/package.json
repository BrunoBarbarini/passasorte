{
  "name": "@passasorte/api",
  "version": "0.0.0",
  "private": true,
  "description": "PassaSorte HTTP API (modular monolith) - CLAUDE.md #10, #16.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --import ./src/telemetry-preload.ts src/main.ts",
    "start": "node --import ./dist/telemetry-preload.js dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.6",
    "@nestjs/core": "^10.4.6",
    "@nestjs/platform-fastify": "^10.4.6",
    "@passasorte/api-contract": "workspace:*",
    "@passasorte/application": "workspace:*",
    "@passasorte/config": "workspace:*",
    "@passasorte/domain": "workspace:*",
    "@passasorte/observability": "workspace:*",
    "@prisma/client": "^5.22.0",
    "fastify": "^5.1.0",
    "jose": "^5.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.5"
  }
}
